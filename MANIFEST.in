include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include ACKNOWLEDGMENTS.md
include llms.txt
include llms-full.txt
include mkdocs.yml
recursive-include docs *.md
recursive-include docs/assets *
recursive-include playground *.html *.md
